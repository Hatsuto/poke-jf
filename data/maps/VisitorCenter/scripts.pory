// NPC triggers

script VisCen_Professor
{
	if(!flag(FLAG_RIVAL_START)) //Starter selection
	{
		msgbox(format("???: What's the matter, big winner? Tough decision?\p"
			"…There's no strings attached, I promise!")
			,MSGBOX_NPC)
	}
	else // Only other event is Rival selection
	{
		lock
		faceplayer
		msgbox(format("???: Hmm? What, you want to battle me or something?")
			,MSGBOX_YESNO)
		
		if(var(VAR_RESULT) == 1)
		{
			if (flag(FLAG_ALPHA_NO) && flag(FLAG_BETA_NO))
			{
				msgbox(format("Did neither of them want to? Really…? "
					"{FONT_SMALL}Ugh…{FONT_NORMAL}\p"
					"Fine, fine. If I've gotta break the ice for you, it's better than nothing."))
				closemessage
				applymovement(PROF_ID, Common_Movement_WalkInPlaceDown)
				waitmovement(0)
				applymovement(ALPHA_ID, Common_Movement_FaceUp)
				applymovement(BETA_ID, Common_Movement_FaceUp)
				msgbox(format("Hey, you two come here for a sec.")
					,MSGBOX_AUTOCLOSE)
				
				//Transition to prof battle event
				setvar(OPP_SPRITE_ID,PROF_ID)
				setvar(VAR_VISCEN_STATE, 0x30)
				
				goto(Battle_Transition)
			}
			elif (!flag(FLAG_PROF_REFUSE))
			{
				msgbox(format("Come on… did you even try talking to the other two yet?\p"
					"Competing with others your age is much more mentally stimulating.\p"
					"Besides, I'm not really supposed to be involved in the{COLOR BLUE}"
					"stud-{COLOR DARK_GRAY}\lin your Pokémon Journey.")
					,MSGBOX_AUTOCLOSE)
				setflag(FLAG_PROF_REFUSE)
			}
			else
			{
				msgbox(format("I said no already, kid. Why don't you{COLOR RED}"
					"ask one of those two{COLOR DARK_GRAY} instead?")
					,MSGBOX_AUTOCLOSE)
			}
		}
		else
		{
			msgbox(format("Of course, don't be silly…\p"
				"You've got two eager {COLOR RED}rivals{COLOR DARK_GRAY} right there. Just ask them!")
				,MSGBOX_AUTOCLOSE)
		}
	}
	end
}
script(local) Prof_Hop // He just does this a lot
{
	playse(SE_LEDGE)
	applymovement(PROF_ID, Common_Movement_HopDown)
	waitmovement(PROF_ID)
}

script VisCen_Liam
{
	// Flavor text
	if(!flag(FLAG_EVENT_START))
	{
		msgbox(format("BOY: He said I'm a winner, but it doesn't change my goals!\p"
			"I'll catch the strongest Pokémon out there!")
			,MSGBOX_NPC)
		applymovement(ALPHA_ID, Common_Movement_FaceUp)
		waitmovement(0)
	}
	elif(!flag(FLAG_RIVAL_START))
	{
		msgbox(format("BOY: So, you're the one who won first place.\p"
			"Just don't take the good one!")
			,MSGBOX_NPC)
	}
	else
	{
		lock
		faceplayer
		msgbox(format("BOY: Picking me, huh? Well, I'm not about to miss my first shot!")
			,MSGBOX_YESNO)
		
		if(var(VAR_RESULT) == 1)
		{
			// Transition to alpha battle event
			setvar(VAR_VISCEN_STATE, 0x10)
			setvar(OPP_SPRITE_ID,ALPHA_ID)
			setvar(VAR_MUGSHOT_ID, MUGSHOT_LIAM)
			call(RivalLink_Add_Liam)
			
			goto(Battle_Transition)
		}
		else
		{
			msgbox(format("What, don't get scared! I'll go easy on you!"))
			setflag(FLAG_ALPHA_NO)
		}
		release
	}
	end
}

script VisCen_Olive
{
	// Flavor text
	if(!flag(FLAG_EVENT_START))
	{
		msgbox(format("GIRL: Hmm… a free Pokémon, huh-?\l"
			"That's a lot of responsibility…")
			,MSGBOX_NPC)
		applymovement(BETA_ID, Common_Movement_FaceUp)
		waitmovement(0)
	}
	elif(!flag(FLAG_RIVAL_START))
	{
		msgbox(format("GIRL: Lucky you-!\p"
			"Did you hear? I get to have the last Pokémon!")
			,MSGBOX_NPC)
	}
	else
	{
		lock
		faceplayer
		bufferspeciesname(2, VAR_BETA_STARTER)
		msgbox(format("GIRL: {STR_VAR_3} and I…? Well, why not!")
			,MSGBOX_YESNO)
		
		if(var(VAR_RESULT) == 1)
		{
			// Transition to beta battle event
			setvar(VAR_VISCEN_STATE, 0x20)
			setvar(OPP_SPRITE_ID,BETA_ID)
			setvar(VAR_MUGSHOT_ID, MUGSHOT_OLIVE)
			call(RivalLink_Add_Olive)
			
			goto(Battle_Transition)
		}
		else
		{
			msgbox(format("GIRL: Oh…? Well, why not?"))
			setflag(FLAG_BETA_NO)
		}
		release
	}
	end
}


