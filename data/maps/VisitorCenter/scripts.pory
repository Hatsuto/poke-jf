script VisCen_LassGramps
{
	lockall
	applymovement(GRAMPS_ID,Common_Movement_FaceUp)
	applymovement(LASS_ID,Common_Movement_WalkInPlaceDown)
	waitmovement(0)
	if(!flag(FLAG_EVENT_START))
	{
		msgbox(format("GIRL: Grandpa, did you hold onto your ticket?"))
		applymovement(GRAMPS_ID,Common_Movement_WalkInPlaceUp)
		msgbox(format("GRAMPS: Hm?{PAUSE 16} What's that??{PAUSE 16}\nSpeak up, kiddo!"))
		applymovement(LASS_ID,Common_Movement_WalkInPlaceDown)
		msgbox(format("GIRL: THE TICKET, GRANDPA.\n"
			"THE {COLOR BLUE}RAFFLE TICKET{COLOR DARK_GRAY} FOR A FREE POKéMON?"))
		applymovement(GRAMPS_ID,Common_Movement_WalkInPlaceUp)
		msgbox(format("GRAMPS: Hah???"))
	}
	else
	{
		msgbox(format("GIRL: Looks like we didn't win, huh gramps?"))
		applymovement(GRAMPS_ID,Common_Movement_WalkInPlaceUp)
		msgbox(format("GRAMPS: Givin' away Pokémon for free… hah!"
			"In my day, you had to wrangle your Pokémon with your own two hands!!"))
		applymovement(LASS_ID,Common_Movement_WalkInPlaceDown)
		msgbox(format("GIRL: Is… that even remotely true?"))
	}
	releaseall
	end
}
