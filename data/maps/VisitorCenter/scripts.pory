movement Prof_WalkBehindBushes_1
{
	jump_in_place_down
	delay_8
}
movement Prof_WalkBehindBushes_2
{
	walk_fast_left
	walk_in_place_faster_down
}

movement Player_Ball_TopLeft
{
	walk_left
	walk_down * 2
	walk_right
	face_up
}
movement Player_Ball_Left
{
	walk_down
	walk_right
	face_up
}
movement Player_Ball_TopRight
{
	walk_right
	walk_down * 2
	walk_left
	face_up
}
movement Player_Ball_Right
{
	walk_down
	walk_left
	face_up
}


movement Liam_Ball_L
{
	walk_fast_up * 2
	walk_fast_right
	walk_in_place_faster_up
}
movement Liam_Ball_M
{
	walk_fast_up
	walk_fast_right * 2
	walk_fast_up
}
movement Liam_Ball_R
{
	walk_fast_up
	walk_fast_right * 3
	walk_fast_up
}

movement Olive_Ball_L
{
	walk_up
	walk_in_place_left
	walk_left * 3
	walk_up
}
movement Olive_Ball_M
{
	walk_up
	walk_in_place_left
	walk_left * 2
	walk_up
}
movement Olive_Ball_R
{
	walk_up * 2
	walk_in_place_left
	walk_left
	walk_in_place_faster_up
}

// *****
//	Movements for Liam and Olive on randomized rival selection
//	Naming: [Object]_Choice[A/B]_P[X]
//		ex. Liam_ChoiceA_P2: Liam's movement when being chosen when player is on 2nd ball
//
//	Balls:
//	G F W
//
//	Generic: 
//	(P1) A2* B3
//	B1 (P2) A3*
//	A walkinplace left
//
//	B1* (P2) A3
//	B walkinplace right
//	*****

//	A1* B2 (P3)
//		A and B face (A: common faceright)
//		After a pause, B moves down, then faces up
//		A moves right (common walkright)
movement Liam_ChoiceA_P3
{
	walk_in_place_right
	delay_8 * 8
	walk_right
	delay_8
}
movement Olive_ChoiceA_P3
{
	delay_8 * 2
	face_left
	delay_8 * 4
	walk_down
	face_up
}

//	(P1) A2 B3*
//	B looks left and head follows A movement
//	Short delay, A walks down and looks left
//	After another delay, B walks left
movement Liam_ChoiceB_P1
{
	delay_8 * 2
	walk_down
	walk_left * 2
}
movement Olive_ChoiceB_P1
{
	face_left
	delay_8 * 4
	face_down
	delay_8 * 6
	walk_left
	delay_8
}

//	A1 B2* (P3)
//	B looks left, after a delay A looks left too
//	Short delay, then B walkinplaceright
movement Liam_ChoiceB_P3
{
	delay_8 * 2
	face_left
}
movement Olive_ChoiceB_P3
{
	face_left
	delay_8 * 6
	walk_in_place_right
	delay_8
}


movement Prof_Walk_1_1
{
	walk_right * 2
	walk_down
}
movement Prof_Walk_1_2 //Olive is in the way
{
	walk_up
	walk_right * 2
	walk_down * 2
}
movement Prof_Walk_2
{
	walk_down
	walk_left
	walk_in_place_down
}
movement Prof_Walk_3
{
	delay_8 * 4
	walk_left * 2
	walk_in_place_down
}
movement Prof_Center_1
{
	walk_fast_right
	delay_8
	walk_in_place_down
}
movement Prof_Center_2 //Prof was the battler
{
	walk_in_place_faster_up
	delay_8
	walk_in_place_down
}